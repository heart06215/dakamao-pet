# 二进制素材按字节保存，避免 Git 做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.zip binary
*.mp4 binary

# 源码与文档统一 LF，Windows 脚本使用 CRLF
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.lps text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
