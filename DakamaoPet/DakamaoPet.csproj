<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DakamaoPet</RootNamespace>
    <AssemblyName>大卡猫</AssemblyName>
    <Version>0.2.0</Version>
    <ApplicationIcon>Assets\Dakamao.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- VPet 官方动画引擎（Apache-2.0）。若还原报缺 API，可改用预发布版 1.1.0.67-a -->
    <PackageReference Include="VPet-Simulator.Core" Version="1.1.0.66" />
  </ItemGroup>

  <ItemGroup>
    <!-- 把动画包整体复制到输出目录，程序按 相对路径 PetMod\info.lps 加载 -->
    <None Include="PetMod\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\tools\animation_timing.json" LogicalName="DakamaoPet.animation_timing.json" />
  </ItemGroup>

</Project>
